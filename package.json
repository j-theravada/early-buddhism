{
	"name": "gakurin",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"generate-talks": "bun run scripts/generate-talks-json.ts",
		"generate-talks:build": "bun run scripts/generate-talks-for-build.ts",
		"db:seed": "bun run scripts/seed-search-database.ts",
		"db:seed:build": "bun run scripts/seed-search-database-for-build.ts",
		"db:seed:local": "GAKURIN_DATABASE_TARGET=local bun run scripts/seed-search-database.ts",
		"db:seed:turso": "GAKURIN_DATABASE_TARGET=turso bun run scripts/seed-search-database.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "GAKURIN_DATABASE_TARGET=local drizzle-kit migrate",
		"db:migrate:turso": "GAKURIN_DATABASE_TARGET=turso drizzle-kit migrate",
		"update-popular-videos": "bun run scripts/update-popular-videos.ts",
		"prebuild": "bun run generate-talks:build",
		"build": "next build",
		"start": "next start",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check",
		"check:agent-skills": "bash scripts/check-agent-skills.sh"
	},
	"dependencies": {
		"@clerk/localizations": "^4.15.8",
		"@clerk/nextjs": "^7.8.3",
		"@clerk/ui": "^1.31.0",
		"@libsql/client": "^0.17.4",
		"@next/third-parties": "^16.1.6",
		"babel-plugin-react-compiler": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^0.575.0",
		"next": "16.1.6",
		"nextjs-toploader": "^3.9.17",
		"radix-ui": "^1.4.3",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.3.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"baseline-browser-mapping": "^2.10.0",
		"clerk": "^3.2.0",
		"drizzle-kit": "^0.31.10",
		"happy-dom": "^20.10.6",
		"knip": "^5.85.0",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"shadcn": "^3.8.5",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3"
	}
}
