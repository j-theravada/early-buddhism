{
	"name": "gakurin",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"generate-talks": "bun run scripts/generate-talks-json.ts",
		"generate-talks:build": "bun run scripts/generate-talks-for-build.ts",
		"db:seed": "bun run scripts/seed-search-database.ts",
		"db:seed:build": "bun run scripts/seed-search-database-for-build.ts",
		"db:seed:local": "GAKURIN_DATABASE_TARGET=local bun run scripts/seed-search-database.ts",
		"db:seed:turso": "GAKURIN_DATABASE_TARGET=turso bun run scripts/seed-search-database.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:build": "bun run scripts/migrate-database-for-build.ts",
		"db:migrate:local": "GAKURIN_DATABASE_TARGET=local drizzle-kit migrate",
		"db:migrate:turso": "GAKURIN_DATABASE_TARGET=turso drizzle-kit migrate",
		"update-popular-videos": "bun run scripts/update-popular-videos.ts",
		"prebuild": "bun run db:migrate:build && bun run generate-talks:build",
		"build": "next build",
		"start": "next start",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check",
		"check:agent-skills": "bash scripts/check-agent-skills.sh"
	},
	"dependencies": {
		"@clerk/localizations": "^4.16.0",
		"@clerk/nextjs": "^7.9.0",
		"@clerk/ui": "^1.32.1",
		"@libsql/client": "^0.18.0",
		"@next/third-parties": "^16.3.4",
		"@vercel/oidc": "^3.8.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"google-auth-library": "^11.0.2",
		"lucide-react": "^1.40.0",
		"next": "16.3.4",
		"nextjs-toploader": "^3.9.17",
		"radix-ui": "^1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@zap-studio/oxlint": "^2.2.1",
		"baseline-browser-mapping": "^2.11.20",
		"clerk": "^3.3.0",
		"drizzle-kit": "^0.31.10",
		"happy-dom": "^20.13.2",
		"knip": "^6.34.0",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"shadcn": "^4.20.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"lefthook"
	]
}
